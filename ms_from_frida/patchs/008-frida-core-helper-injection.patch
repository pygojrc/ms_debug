+		private CodeLayout compute_code_layout (uint8[] code, string data) {
+			var layout = CodeLayout ();
+
+			size_t code_size = round_size_to_page_size (code.length);
+
+			size_t data_size = 0;
+			data_size += sizeof (HelperCodeContext);
+			data_size += sizeof (HelperLibcApi);
+			data_size += data.data.length + 1;
+			data_size = round_size_to_page_size (data_size);
+
+			layout.size = code_size + data_size;
+
+			layout.ctx_offset = code_size;
+			layout.libc_api_offset = layout.ctx_offset + sizeof (HelperCodeContext);
+			layout.data_offset = layout.libc_api_offset + sizeof (HelperLibcApi);
+
+			return layout;
+		}
