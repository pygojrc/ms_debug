+#ifdef HAVE_ANDROID
+static gboolean gum_is_art_pretty_method (gpointer function_address);
+#endif
+
+#ifdef HAVE_ANDROID
+
+static gboolean
+gum_is_art_pretty_method (gpointer function_address)
+{
+  Dl_info info;
+  const gchar * module_name;
+  const gchar * symbol_name;
+  gboolean matched;
+
+  if (dladdr (function_address, &info) == 0)
+  {
+    return FALSE;
+  }
+
+  module_name = info.dli_fname != NULL ? info.dli_fname : "";
+  symbol_name = info.dli_sname != NULL ? info.dli_sname : "";
+  matched = strstr (module_name, "libart.so") != NULL &&
+      (strstr (symbol_name, "ArtMethod") != NULL ||
+       strstr (symbol_name, "PrettyMethod") != NULL) &&
+      strstr (symbol_name, "PrettyMethod") != NULL;
+
+  if (matched)
+  {
+  }
+  else if (strstr (module_name, "libart.so") != NULL ||
+      strstr (symbol_name, "PrettyMethod") != NULL)
+  {
+  }
+
+  return matched;
+}
+
+#endif
