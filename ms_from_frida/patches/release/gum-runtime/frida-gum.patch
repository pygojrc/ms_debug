 GumInterceptorBackend *
 _gum_interceptor_backend_create (GRecMutex * mutex,
                                  GumCodeAllocator * allocator)
@@ -660,6 +705,7 @@ gum_interceptor_backend_prepare_trampoline (GumInterceptorBackend * self,
 
   data->scratch_reg = ctx->scratch_register;
 
+
   if (ctx->write_redirect != NULL)
   {
     guint scan_bytes;
@@ -689,9 +735,24 @@ gum_interceptor_backend_prepare_trampoline (GumInterceptorBackend * self,
     return TRUE;
   }
 
+#ifdef HAVE_ANDROID
+  if (gum_is_art_pretty_method (function_address) &&
+      gum_arm64_relocator_can_relocate (function_address,
+        GUM_INTERCEPTOR_PRETTY_METHOD_REDIRECT_SIZE, scenario,
+        ctx->relocation_policy, &redirect_limit, &data->scratch_reg))
+  {
+    data->redirect_code_size = GUM_INTERCEPTOR_PRETTY_METHOD_REDIRECT_SIZE;
+
+    ctx->trampoline_slice = gum_code_allocator_alloc_slice (self->allocator);
+  }
+  else if (gum_arm64_relocator_can_relocate (function_address,
+        GUM_INTERCEPTOR_FULL_REDIRECT_SIZE, scenario, ctx->relocation_policy,
+        &redirect_limit, &data->scratch_reg))
+#else
   if (gum_arm64_relocator_can_relocate (function_address,
         GUM_INTERCEPTOR_FULL_REDIRECT_SIZE, scenario, ctx->relocation_policy,
         &redirect_limit, &data->scratch_reg))
+#endif
   {
     data->redirect_code_size = GUM_INTERCEPTOR_FULL_REDIRECT_SIZE;
 
@@ -774,6 +835,7 @@ gum_interceptor_backend_prepare_trampoline (GumInterceptorBackend * self,
         : ARM64_REG_X16;
   }
 
+
   return TRUE;
 
 no_scratch_reg:
@@ -1126,6 +1188,13 @@ _gum_interceptor_backend_activate_trampoline (GumInterceptorBackend * self,
         gum_arm64_writer_put_ldr_reg_address (aw, data->scratch_reg, on_enter);
         gum_arm64_writer_put_br_reg (aw, data->scratch_reg);
         break;
+      case GUM_INTERCEPTOR_PRETTY_METHOD_REDIRECT_SIZE:
+        /* PrettyMethod 特例：先写两条固定指令，再接原 ldr + br 跳转。 */
+        gum_arm64_writer_put_instruction (aw, 0xD2400000);
+        gum_arm64_writer_put_instruction (aw, 0xD2400000);
+        gum_arm64_writer_put_ldr_reg_address (aw, data->scratch_reg, on_enter);
+        gum_arm64_writer_put_br_reg (aw, data->scratch_reg);
+        break;
       default:
         g_assert_not_reached ();
     }
